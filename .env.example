# Copy to .env (local) and add the same vars on Vercel (Project → Settings → Environment Variables)

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact-form briefs (defaults to studio@tangison.com)
CONTACT_TO=studio@tangison.com

# Sender shown in the inbox. The default is Resend's test sender, which only
# delivers to the email that owns the Resend account. After you verify
# tangison.com in Resend, switch to a real sender, e.g.:
# CONTACT_FROM=Studio <briefs@tangison.com>
CONTACT_FROM=Tangison Studio <onboarding@resend.dev>
