# Copy to .env (local) and add the same vars on Vercel (Project → Settings → Environment Variables)

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact-form briefs (defaults to studio@tangison.com)
CONTACT_TO=studio@tangison.com

# Sender shown in the inbox. studio.tangison.com is verified in Resend
# (sending enabled), so this default delivers to any inbox.
CONTACT_FROM=Studio <briefs@studio.tangison.com>
